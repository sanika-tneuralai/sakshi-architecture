# ============================================================================
# Camera-Detection Service Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/goec

# Individual database connection parameters (alternative to DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=goec

# ----------------------------------------------------------------------------
# DeepStream Configuration
# ----------------------------------------------------------------------------
# Path to NVIDIA DeepStream SDK libraries
DEEPSTREAM_PATH=/opt/nvidia/deepstream/deepstream-6.4/lib

# ----------------------------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------------------------
# Path to YOLO model file (relative to container)
YOLO_MODEL_PATH=/app/models/yolo11n.pt

# Detection confidence threshold (0.0 - 1.0)
DEFAULT_CONFIDENCE_THRESHOLD=0.5

# Intersection over Union (IoU) threshold for NMS (0.0 - 1.0)
DEFAULT_IOU_THRESHOLD=0.45

# ----------------------------------------------------------------------------
# Storage Configuration
# ----------------------------------------------------------------------------
# Directory for storing detection screenshots
SCREENSHOTS_DIR=/app/screenshots

# Directory for storing application logs
LOGS_DIR=/app/logs

# ----------------------------------------------------------------------------
# Camera Configuration
# ----------------------------------------------------------------------------
# Default FPS for camera streams (1-30)
DEFAULT_CAMERA_FPS=5

# Maximum number of cameras for single-stream mode
MAX_SINGLE_CAMERAS=10

# Buffer size for camera frames
FRAME_BUFFER_SIZE=10

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
# Service port
API_PORT=8000

# CORS allowed origins (comma-separated or * for all)
CORS_ORIGINS=*

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Hardware Configuration
# ----------------------------------------------------------------------------
# GPU device ID (for multi-GPU systems)
GPU_DEVICE_ID=0

# Enable/disable GPU acceleration (true/false)
USE_GPU=true

# ----------------------------------------------------------------------------
# Performance Tuning
# ----------------------------------------------------------------------------
# Number of worker threads for frame processing
WORKER_THREADS=4

# Maximum queue size for pending frames
MAX_QUEUE_SIZE=100

# Frame processing timeout (seconds)
FRAME_TIMEOUT=30

# ----------------------------------------------------------------------------
# Service Communication (for orchestrator)
# ----------------------------------------------------------------------------
# This service's external URL (used by orchestrator)
CAMERA_DETECTION_SERVICE_URL=http://camera-detection:8000

# ----------------------------------------------------------------------------
# Development/Debug Settings
# ----------------------------------------------------------------------------
# Enable debug mode (adds verbose logging)
DEBUG_MODE=false

# Enable API reload on code changes (development only)
API_RELOAD=false

# Save every Nth detection frame for debugging
DEBUG_SAVE_EVERY_N_FRAMES=0

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# 1. Copy this file to .env and update values for your environment
# 2. Never commit .env file to version control
# 3. For production, use stronger database credentials
# 4. Ensure DeepStream SDK is installed at the specified path
# 5. Place YOLO model files in the ./models directory
# 6. Adjust confidence threshold based on your use case
# 7. GPU is required for optimal performance
