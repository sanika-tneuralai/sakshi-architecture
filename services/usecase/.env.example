# ==============================================================================
# USECASE EVALUATION SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# Host and port for the usecase service
HOST=0.0.0.0
PORT=8001

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string (shared database across all services)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://goec:goec@localhost:5432/goec

# Database connection details (for docker-compose)
POSTGRES_DB=goec
POSTGRES_USER=goec
POSTGRES_PASSWORD=goec
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# USECASE RULES CONFIGURATION
# ------------------------------------------------------------------------------
# These can be overridden for custom rule behavior

# Person in ROI rule - minimum confidence threshold
PERSON_IN_ROI_MIN_CONFIDENCE=0.5

# Crowd in ROI rule - minimum person count to trigger
CROWD_IN_ROI_MIN_COUNT=3
CROWD_IN_ROI_MIN_CONFIDENCE=0.5

# Restricted zone rule - object types to detect
RESTRICTED_ZONE_VEHICLE_TYPES=car,truck,bus,motorcycle
RESTRICTED_ZONE_MIN_CONFIDENCE=0.5

# ------------------------------------------------------------------------------
# NOTES
# ------------------------------------------------------------------------------
# 1. This service connects to the SAME PostgreSQL database as other services
# 2. Ensure DATABASE_URL matches across all services in your deployment
# 3. For production, use strong passwords and secure connection strings
# 4. The service will create necessary database tables on startup
# 5. Port 8001 is the default; ensure it doesn't conflict with other services
# ==============================================================================
