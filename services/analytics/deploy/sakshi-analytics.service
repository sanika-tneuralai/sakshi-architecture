[Unit]
Description=Sakshi Analytics Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/analytics/sakshi-architecture/services/analytics
EnvironmentFile=-/home/ubuntu/.env.analytics
ExecStart=/home/ubuntu/venv/bin/python3 main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
