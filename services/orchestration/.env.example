# =============================================================================
# Orchestration Service Configuration
# =============================================================================
# Copy this file to .env and update with your actual configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Service URLs - Update based on your deployment
# -----------------------------------------------------------------------------

# Camera-Detection Service (handles camera operations and object detection)
# Development: http://localhost:8001
# Production: http://<server1-ip>:8001
CAMERA_DETECTION_URL=http://localhost:8001

# Usecase Service (handles usecase evaluation and rule processing)
# Development: http://localhost:8002
# Production: http://<server3-ip>:8002
USECASE_SERVICE_URL=http://localhost:8002

# Alert Service (handles alert generation and notifications)
# Development: http://localhost:8003
# Production: http://<server3-ip>:8003
ALERT_SERVICE_URL=http://localhost:8003

# -----------------------------------------------------------------------------
# HTTP Request Configuration
# -----------------------------------------------------------------------------

# Timeout for HTTP requests to services (in seconds)
REQUEST_TIMEOUT=30

# Maximum number of retries for failed requests
MAX_RETRIES=3

# Backoff factor for retries (delay = backoff_factor * (2 ^ retry_number))
RETRY_BACKOFF_FACTOR=0.5

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Port for the orchestration service
PORT=8000

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database Configuration (Optional)
# -----------------------------------------------------------------------------
# Only needed if you want to log pipeline executions to database

# Database connection URL
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:postgres@localhost:5432/goec
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goec

# -----------------------------------------------------------------------------
# Deployment Examples
# -----------------------------------------------------------------------------

# Example 1: Local Development (all services on localhost)
# CAMERA_DETECTION_URL=http://localhost:8001
# USECASE_SERVICE_URL=http://localhost:8002
# ALERT_SERVICE_URL=http://localhost:8003

# Example 2: Docker Compose (services by container name)
# CAMERA_DETECTION_URL=http://camera-detection:8001
# USECASE_SERVICE_URL=http://usecase:8002
# ALERT_SERVICE_URL=http://alert:8003

# Example 3: Multi-Server Deployment
# CAMERA_DETECTION_URL=http://192.168.1.100:8001  # Server 1
# USECASE_SERVICE_URL=http://192.168.1.102:8002   # Server 3
# ALERT_SERVICE_URL=http://192.168.1.102:8003     # Server 3

# Example 4: Production with Domain Names
# CAMERA_DETECTION_URL=https://camera.example.com
# USECASE_SERVICE_URL=https://usecase.example.com
# ALERT_SERVICE_URL=https://alert.example.com
