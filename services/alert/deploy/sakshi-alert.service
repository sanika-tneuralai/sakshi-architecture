[Unit]
Description=Sakshi Alert Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/alertapi/sakshi-architecture/services/alert
EnvironmentFile=-/home/ubuntu/.env.alert
ExecStart=/home/ubuntu/venv/bin/python3 main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
