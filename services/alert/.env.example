# ==============================================================================
# ALERT SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# Host and port for the alert service
ALERT_SERVICE_HOST=0.0.0.0
ALERT_SERVICE_PORT=8002

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string (shared database across all services)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://goec:goec@localhost:5432/goec

# Database connection details (for docker-compose)
POSTGRES_DB=goec
POSTGRES_USER=goec
POSTGRES_PASSWORD=goec
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# ALERT CHANNEL CONFIGURATION - EMAIL
# ------------------------------------------------------------------------------
# Enable/disable email alerts
ALERT_EMAIL_ENABLED=false

# SMTP server configuration
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587

# Email credentials
ALERT_EMAIL_USERNAME=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password

# From and To addresses
ALERT_EMAIL_FROM=alerts@goec.com
ALERT_EMAIL_TO=admin@goec.com,security@goec.com

# ------------------------------------------------------------------------------
# ALERT CHANNEL CONFIGURATION - SMS
# ------------------------------------------------------------------------------
# Enable/disable SMS alerts
ALERT_SMS_ENABLED=false

# SMS provider (twilio, nexmo, etc.)
ALERT_SMS_PROVIDER=twilio

# Twilio configuration
ALERT_SMS_ACCOUNT_SID=your-twilio-account-sid
ALERT_SMS_AUTH_TOKEN=your-twilio-auth-token
ALERT_SMS_FROM=+1234567890
ALERT_SMS_TO=+1987654321,+1555555555

# ------------------------------------------------------------------------------
# ALERT CHANNEL CONFIGURATION - WEBHOOK
# ------------------------------------------------------------------------------
# Enable/disable webhook alerts
ALERT_WEBHOOK_ENABLED=false

# Webhook URL and method
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
ALERT_WEBHOOK_METHOD=POST

# Optional: Custom headers (JSON format)
# ALERT_WEBHOOK_HEADERS={"Content-Type": "application/json", "X-API-Key": "your-key"}

# Optional: Bearer token for authentication
ALERT_WEBHOOK_AUTH_TOKEN=your-bearer-token

# ------------------------------------------------------------------------------
# ALERT BEHAVIOR CONFIGURATION
# ------------------------------------------------------------------------------
# Alert cooldown period in seconds (prevent duplicate alerts)
ALERT_COOLDOWN_SECONDS=300

# Maximum retries for failed alert delivery
ALERT_MAX_RETRIES=3

# Retry delay in seconds
ALERT_RETRY_DELAY_SECONDS=60

# ------------------------------------------------------------------------------
# NOTES
# ------------------------------------------------------------------------------
# 1. This service connects to the SAME PostgreSQL database as other services
# 2. At least ONE alert channel should be enabled (email, SMS, or webhook)
# 3. For Gmail, use App Passwords: https://support.google.com/accounts/answer/185833
# 4. For Twilio SMS: https://www.twilio.com/docs/sms/quickstart
# 5. Webhook alerts send JSON payload with alert details
# 6. Multiple recipients can be specified (comma-separated)
