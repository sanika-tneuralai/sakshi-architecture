# Models (can be large) — do not commit binaries.
# Un-anchored (**/) so nested service dirs like services/*/models/ are covered;
# the plain models/*.pt form is anchored to the repo root and misses them.
models/*.pt
models/*.onnx
models/*.hef
**/*.pt
**/*.onnx
**/*.engine
**/*.hef
**/*.wts

